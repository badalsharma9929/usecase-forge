# Required for the shared demo key (visitors can also bring their own key)
GOOGLE_API_KEY=

# Required on Vercel: random string used to encrypt visitors' own keys in the queue
RUN_SECRET=

# Optional
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
DAILY_RUN_LIMIT=3
APPROVAL_SCORE=7
MAX_REVISIONS=2
JINA_API_KEY=
KAGGLE_API_TOKEN=

# Set automatically when a Vercel Blob store is connected to the project
# BLOB_READ_WRITE_TOKEN=
